# Salin ke .env lalu isi kredensial LLM (file .env tidak ikut ter-commit).
LLM_BASE_URL=https://api.chatetin.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=cmd
# Opsional
LLM_BATCH_SIZE=40
LLM_TIMEOUT=90
LLM_MAX_TOKENS=8000

# Opsional: toleransi discovery scraping keyword/profil
SCRAPE_DISCOVERY_WAIT_MS=5000
SCRAPE_DISCOVERY_STALL=4
SCRAPE_DISCOVERY_ROUNDS_EXTRA=20
SCRAPE_SCROLL_WAIT_MIN_MS=1200
SCRAPE_SCROLL_WAIT_MAX_MS=2200
