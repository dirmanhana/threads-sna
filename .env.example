# Salin ke .env lalu isi kredensial LLM (file .env tidak ikut ter-commit).
LLM_BASE_URL=https://api.chatetin.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=cmd
# Opsional: browser untuk login/scraping. "chrome" memakai Google Chrome asli
# (fingerprint lebih normal); "none" memakai Chromium bawaan Playwright.
THREADS_BROWSER_CHANNEL=chrome
LLM_BATCH_SIZE=40
LLM_TIMEOUT=90
LLM_MAX_TOKENS=8000

# Mesin sentimen: "llm" (API, default) atau "indobert" (lokal, tanpa API).
# indobert hanya mengisi label sentimen (positif/negatif/netral); emosi,
# toksisitas, spam, dan topik tetap kosong karena model 3 kelas ini tidak
# memprediksinya. Butuh: pip install torch transformers sentencepiece
SENTIMENT_ENGINE=llm
INDOBERT_MODEL=Aardiiiiy/indobertweet-base-Indonesian-sentiment-analysis
# Device untuk engine indobert: auto (default, GPU bila ada) | cuda | cuda:0 | cpu
INDOBERT_DEVICE=auto

# Opsional: toleransi discovery scraping keyword/profil
SCRAPE_DISCOVERY_WAIT_MS=5000
SCRAPE_DISCOVERY_STALL=4
SCRAPE_DISCOVERY_ROUNDS_EXTRA=20
SCRAPE_SCROLL_WAIT_MIN_MS=1200
SCRAPE_SCROLL_WAIT_MAX_MS=2200
